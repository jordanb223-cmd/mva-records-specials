    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.8.7",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
